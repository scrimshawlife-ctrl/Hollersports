{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SettlementPacket.v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "authority",
    "capital_authority",
    "execution_authority"
  ],
  "properties": {
    "schema_version": { "const": "SettlementPacket.v1" },
    "status": {
      "enum": ["PENDING", "WIN", "LOSS", "PUSH", "VOID", "NOT_COMPUTABLE"]
    },
    "entry_id": { "type": "string" },
    "run_id": { "type": "string" },
    "portfolio_id": { "type": "string" },
    "event_id": { "type": "string" },
    "market_id": { "type": "string" },
    "selection": { "type": "string" },
    "stake": { "type": "number" },
    "price": { "type": "number" },
    "pnl": { "type": "number" },
    "final_score": { "type": ["string", "null"] },
    "result_source": { "type": "string" },
    "settled_at": { "type": "string" },
    "authority": { "type": "string" },
    "capital_authority": { "const": false },
    "execution_authority": { "const": false },
    "provenance": { "type": "object" },
    "reason": { "type": "string" }
  },
  "additionalProperties": true
}
